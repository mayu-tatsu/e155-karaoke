$var reg 16 % pcm_out [15:0] $end
$var reg 1 & sck $end
$var reg 1 ' sdo $end

$scope task send_audio_sample $end
$var reg 16 ( data [15:0] $end
$upscope $end

$scope task monitor_spi_transmission $end
$var reg 16 ) received_data [15:0] $end
$var integer 32 * bit_index $end
$upscope $end

$scope module dut $end
